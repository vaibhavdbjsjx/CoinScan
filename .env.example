# =============================================================================
# CoinScan Flutter app & web build — PUBLIC CLIENT VARIABLES
# =============================================================================
# These values are compiled into the mobile app and the web bundle
# (flutter --dart-define, or Vercel environment variables for the web build)
# and are visible to anyone who has the app. Only public values belong here.
#
# SERVER-ONLY SECRETS (database URL, OpenAI / Numista / metals keys, Supabase
# service-role or secret keys, JWT secret, guest-quota and RevenueCat webhook
# secrets) live in backend/.env.example and must NEVER be added to Flutter,
# Vercel or any client.
#
# This file documents the variables; nothing reads it automatically.
# =============================================================================

APP_ENV=production
# CoinScan API base URL (Railway domain or custom domain), https only
BACKEND_URL=https://<your-api-domain>
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon or publishable key (sb_publishable_...). Never a secret or service-role key.
SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
# RevenueCat PUBLIC SDK keys (appl_... / goog_...), mobile builds only
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=

# Development builds only — never set for production or web builds:
# API_KEY=
