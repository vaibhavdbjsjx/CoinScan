# CoinScan Backend Environment Configuration Template
# =============================================================================
# Used for local development and unit tests. In production (Google Cloud Run),
# secrets are mounted dynamically via Google Secret Manager.
# =============================================================================

APP_NAME=coinscan-backend
APP_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=*
API_SECRET=

# Vision AI Provider ('gemini' or 'openai')
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Numismatic Catalogue (Numista API v3)
NUMISTA_API_KEY=
NUMISTA_API_BASE_URL=https://api.numista.com/v3

# Valuation Spot & FX Providers
METALS_API_KEY=
METALS_API_BASE_URL=https://metals-api.com/api/latest
EXCHANGERATE_API_KEY=
EXCHANGERATE_API_BASE_URL=https://open.er-api.com/v6/latest

# Authentication & Payment Webhooks
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Developer API Keys & Tier Mapping (JSON string)
API_KEYS_JSON=

# Observability
SENTRY_DSN=
CLOUD_RUN_SERVICE_URL=

# Request Constraints
MAX_UPLOAD_MB=20
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=60
