# =============================================================================
# CoinScan API (FastAPI) — SERVER-SIDE configuration template
# =============================================================================
# Local development: copy to backend/.env (git-ignored).
# Railway: set these as service variables in Railway, never in a committed file.
#
# Everything here belongs to the API server only. NONE of it may be placed in
# the Flutter app, the web build, Vercel, or any other client bundle.
# Public client settings are listed separately in /.env.example.
#
# This template contains placeholders only — never real values.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment — decides the security mode
# -----------------------------------------------------------------------------
# production | staging   hardened: strict token checks, required settings
#                        checked at startup, no development aids.
# development | test     local only: mock bearer tokens, mock vision provider,
#                        static dev keys. NEVER on a public server.
# If APP_ENV is unset the API runs as production.
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info
# CORS: comma-separated web origins (your Vercel domain in production).
ALLOWED_ORIGINS=*
# Railway injects PORT automatically; local runs default to 8080.
# PORT=8080
# Worker processes (default 1). Keep 1, with one Railway replica: the per-minute
# rate limits and in-flight scan reservations are kept in process memory.
# WEB_CONCURRENCY=1
# Client address (guest-quota hashing and rate limits; never stored).
# Railway: CLIENT_IP_HEADER=X-Real-IP (set by Railway's edge). Verify after the
# first deploy that it carries real client addresses, not proxy addresses.
# Leave empty locally.
CLIENT_IP_HEADER=
# Alternative for proxies that APPEND to X-Forwarded-For: number of trusted
# proxies (client = N-th entry from the right). 0 = TCP peer address.
TRUSTED_PROXY_HOPS=0

# =============================================================================
# 2. SERVER-ONLY SECRETS — never in Flutter, web, Vercel or any client
# =============================================================================
# Supabase PostgreSQL. From Railway use the Supavisor SESSION pooler (IPv4):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Railway has no outbound IPv6, so the direct db.<project-ref>.supabase.co host
# is unreachable from it. TLS is required by default in staging/production.
DATABASE_URL=

# Legacy Supabase JWT secret (HS256). Needed only while the project still
# issues HS256 tokens; with Supabase JWT signing keys, tokens are verified with
# the public keys published at SUPABASE_URL and this can stay empty.
SUPABASE_JWT_SECRET=
# Supabase admin credential, used ONLY to delete a user's Supabase Auth login
# when they delete their account. Required in staging/production: without it,
# account deletion is refused (nothing is deleted) and /health/ready is 503.
# Preferred: a secret key (sb_secret_...). Supabase Dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Legacy alternative (service_role JWT), only if no secret key is set. Supabase
# is retiring legacy keys; move to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (approved provider: OpenAI)
OPENAI_API_KEY=
# Numismatic catalogue (required for identification)
NUMISTA_API_KEY=
# Precious-metal spot prices (optional: melt values show as unavailable without it)
METALS_API_KEY=
# Currency rates (optional: the default open.er-api.com endpoint needs no key)
EXCHANGERATE_API_KEY=

# Keyed hashing of guest identifiers. Required in staging/production.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GUEST_QUOTA_HMAC_SECRET=
# Must equal the Authorization header value configured for RevenueCat webhooks.
REVENUECAT_WEBHOOK_SECRET=

# Legacy provider, kept until the Google Cloud retirement (only used with VISION_PROVIDER=gemini).
GEMINI_API_KEY=

# =============================================================================
# 3. Server configuration (not secret)
# =============================================================================
# Supabase project URL, e.g. https://<project-ref>.supabase.co
# The token issuer and the signing-key (JWKS) URL are derived from it.
SUPABASE_URL=
# Optional overrides (defaults shown):
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=600

VISION_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
NUMISTA_API_BASE_URL=https://api.numista.com/v3
METALS_API_BASE_URL=https://metals-api.com/api/latest
EXCHANGERATE_API_BASE_URL=https://open.er-api.com/v6/latest

GUEST_DAILY_SCAN_LIMIT=2
GUEST_NETWORK_DAILY_SCAN_LIMIT=20
REQUIRED_TERMS_VERSION=1.0.0
REQUIRED_PRIVACY_VERSION=1.0.0
REVENUECAT_PRO_ENTITLEMENT_IDS=pro
REVENUECAT_PLUS_ENTITLEMENT_IDS=plus
REVENUECAT_PRO_PRODUCT_IDS=com.coinscan.pro.monthly,com.coinscan.pro.yearly
REVENUECAT_PLUS_PRODUCT_IDS=com.coinscan.plus.monthly,com.coinscan.plus.yearly

# Database pool per process, timeouts and TLS
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_COMMAND_TIMEOUT_SECONDS=30
# DB_SSL_MODE=require          (default in staging/production)
# DB_TRANSACTION_POOLER=       (auto-detected from port 6543)

# Upload and request limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=12000000
MAX_IMAGE_DIMENSION=4096
MAX_RECOGNITION_REQUEST_MB=32
MAX_REQUEST_KB=1024
# Scans per minute per client address (signed-out and Free users).
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# 4. DEVELOPMENT ONLY — ignored (and logged) in staging/production
# =============================================================================
API_SECRET=
API_KEYS_JSON=
NUMISTA_OFFLINE_FIXTURE=false

# Not read by the code; do not set. (SENTRY_DSN / CLOUD_RUN_SERVICE_URL are from
# the Google Cloud era; HOST / PORT are taken from the container command.)
# SENTRY_DSN=
# CLOUD_RUN_SERVICE_URL=
# REQUEST_TIMEOUT_SECONDS=
